// Generated by AMP on every start from the instance settings.
// Edits made here are overwritten. Change the settings in the AMP web panel instead,
// or point the "Start Script" setting at your own script.

#include "path://media/packages/vanilla/scripts"

#include "gamemode_invasion.as"

void main(dictionary@ inputData) {
	XmlElement inputSettings(inputData);

	UserSettings settings;

	_setupLog("{{ScriptLogLevel}}");

	settings.m_factionChoice = {{FactionChoice}};
	settings.m_fellowCapacityFactor = {{FellowCapacityFactor}};
	settings.m_fellowAiAccuracyFactor = {{FellowAiAccuracyFactor}};
	settings.m_enemyCapacityFactor = {{EnemyCapacityFactor}};
	settings.m_enemyAiAccuracyFactor = {{EnemyAiAccuracyFactor}};
	settings.m_xpFactor = {{XpFactor}};
	settings.m_rpFactor = {{RpFactor}};
	settings.m_initialXp = {{InitialXp}};
	settings.m_initialRp = {{InitialRp}};
	settings.m_maxRp = {{MaxRp}};
	settings.m_playerAiCompensationFactor = {{PlayerAiCompensationFactor}};
	settings.m_playerAiReduction = {{PlayerAiReduction}};
	settings.m_friendlyFire = {{FriendlyFire}};
	settings.m_teamKillPenaltyEnabled = {{TeamKillPenaltyEnabled}};
	settings.m_teamKillsToStartPenalty = {{TeamKillsToStartPenalty}};
	settings.m_journalEnabled = {{JournalEnabled}};
	settings.m_completionVarianceEnabled = {{CompletionVarianceEnabled}};
	settings.m_fellowDisableEnemySpawnpointsSoldierCountOffset = 1;

	array<string> overlays = {
		"media/packages/invasion"
	};
	settings.m_overlayPaths = overlays;

	settings.m_startServerCommand = """
<command class='start_server'
	server_name='{{ServerName}}'
	server_port='{{ServerPort}}'
	comment='{{ServerComment}}'
	url='{{ServerUrl}}'
	register_in_serverlist='{{RegisterInServerList}}'
	mode='COOP'
	persistency='forever'
	max_players='{{MaxPlayers}}'>
	<client_faction id='{{FactionChoice}}' />
</command>
""";

	settings.print();

	GameModeInvasion metagame(settings);

	metagame.init();
	metagame.run();
	metagame.uninit();

	_log("ending execution");
}
