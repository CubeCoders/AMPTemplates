Meta.DisplayName=Desynced
Meta.Description=Desynced Dedicated Server
Meta.Arch=x86_64
Meta.Author=zer0ney
Meta.URL=https://www.desyncedgame.com/
Meta.MinAMPVersion=2.4.6.6
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.ContainerPolicy=SupportedOnWindows,RecommendedOnLinux
Meta.ContainerPolicyReason=The server requires Wine (ideally latest stable from winehq.org) to run on Linux. Using a container avoids the need for you to install this dependency on the host.
Meta.Prerequsites=[]
Meta.EndpointURIFormat=steam://connect/{ip}:{GenericModule.App.Ports.$SteamQueryPort}
Meta.AppConfigId=32917856-06d8-4ffb-bef2-6d0142b03891
App.AdminMethod=STDIO
App.HasReadableConsole=true
App.HasWritableConsole=false
App.DisplayName=Desynced
App.CommandLineArgs={{$PlatformArgs}} {{Savename}}.desynced -stdout -Port={{$MainGamePort}} -QueryPort={{$SteamQueryPort}} -SessionSettings="{'name': '{{SessionName}}', 'players': {{SessionPlayers}}, 'password': '{{SessionPassword}}', 'visibility': '{{SessionVisibility}}', 'mode': '{{SessionMode}}', 'allow_faction_switch': {{SessionAllowFactionSwitch}}, 'block_unlocked_behaviors': {{SessionBlockUnlockedBehaviors}}, 'run_without_players': {{SessionRunWithoutPlayers}}, 'disable_client_save': {{SessionDisableClientSave}}}" -GameSettings="{'seed': {{GameSeed}}, 'elevation_params_freq': {{GameElevationParamsFreq}}, 'elevation_params_scale': {{GameElevationParamsScale}}, 'blight_threshold': {{GameBlightThreshold}}, 'plateau_level': {{GamePlateauLevel}}, 'resource_amt': {{GameResourceAmt}}, 'resource_inf': {{GameResourceInf}}, 'enable_day_night': {{GameEnableDayNight}}, 'day_period': {{GameDayPeriod}}, 'year_period': {{GameYearPeriod}}, 'peaceful': {{GamePeaceful}}, 'difficulty': {{GameDifficulty}}, 'creep': {{GameCreep}}, 'disable_minigames': {{GameDisableMinigames}}}
App.WindowsCommandLineArgs=
App.CommandLineParameterFormat=
App.CommandLineParameterDelimiter=
App.RapidStartup=false
App.ApplicationReadyMode=Immediate
App.ExitMethod=CTRLC
App.ExitString=stop
App.ExitTimeout=30
App.ExitFile=app_exit.lck
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ApplicationIPBinding=0.0.0.0
App.AdminPortRef=RemoteAdminPort
App.UniversalSleepApplicationUDPPortRef=MainGamePort
App.PrimaryApplicationPortRef=MainGamePort
App.UniversalSleepSteamQueryPortRef=SteamQueryPort
App.MaxUsers=8
App.UseRandomAdminPassword=True
App.RemoteAdminPassword=
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=30
App.RCONConnectRetrySeconds=15
App.RCONHeartbeatCommand=ping
App.RCONHeartbeatMinutes=0
App.TelnetLoginFormat={0}
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.TemplateMatchRegex={{(\$?[\w]+)}}
App.MonitorChildProcess=False
App.MonitorChildProcessWaitMs=1000
App.MonitorChildProcessName=
App.Compatibility=None
App.SteamWorkshopDownloadLocation={{$FullBaseDir}}undefined
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.UpdateAvailableRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Console.SleepMode=False
Console.SleepOnStart=False
Console.SleepDelayMinutes=5
Console.DozeDelay=2
Console.AutoRetryCount=5
Console.SleepStartThresholdSeconds=25
Console.AppReadyRegex=^\[BOOT\] Running dedicated server.*$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Meta.OS=3
Meta.ConfigManifest=desyncedconfig.json
Meta.MetaConfigManifest=desyncedmetaconfig.json
Meta.ConfigRoot=desynced.kvp
App.RootDir=./desynced/
Meta.DisplayImageSource=steam:1450900
App.BaseDirectory=./desynced/2943070/
App.WorkingDir=2943070
App.ExecutableWin=2943070\Desynced\Binaries\Win64\DesyncedServer.exe
App.ExecutableLinux=/usr/bin/wine
App.LinuxCommandLineArgs="./Desynced/Binaries/Win64/DesyncedServer.exe" 
App.Ports=@IncludeJson[desyncedports.json]
App.UpdateSources=@IncludeJson[desyncedupdates.json]
App.EnvironmentVariables={"LD_LIBRARY_PATH": "{{$FullBaseDir}}linux64:{{$FullRootDir}}linux64:%LD_LIBRARY_PATH%", "SteamAppId": "2943070", "WINEPREFIX": "{{$FullRootDir}}.wine", "WINEARCH": "win64", "WINEDEBUG": "-all"}
