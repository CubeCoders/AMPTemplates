[
    {
        "ConfigFile": "server.properties",
        "ConfigType": "kvp",
        "ConfigFormat": "{0}{1}",
        "AutoMap": false,
        "Importable": false,
        "Subsections": [
            {
                "Heading": "$root",
                "SettingMappings": {
                    "max-players=": "$MaxUsers",
                    "server-port=": "$ServerPort",
                    "server-ip=": "$ApplicationIPBinding",
                    "motd=": "motd",
                    "version=": "version",
                    "tab-header=": "tab-header",
                    "tab-footer=": "tab-footer",
                    "allow-chat=": "allow-chat",
                    "enforce-whitelist=": "enforce-whitelist",
                    "log-player-ip-addresses=": "log-player-ip-addresses",
                    "handshake-verbose=": "handshake-verbose",
                    "ticks-per-second=": "ticks-per-second",
                    "view-distance=": "view-distance",
                    "level-name=": "level-name",
                    "level-dimension=": "level-dimension",
                    "world-spawn=": "world-spawn",
                    "default-gamemode=": "default-gamemode",
                    "allow-flight=": "allow-flight",
                    "reduced-debug-info=": "reduced-debug-info",
                    "bungeecord=": "bungeecord",
                    "velocity-modern=": "velocity-modern",
                    "bungee-guard=": "bungee-guard",
                    "forwarding-secrets=": "forwarding-secrets",
                    "resource-pack=": "resource-pack",
                    "resource-pack-sha1=": "resource-pack-sha1",
                    "required-resource-pack=": "required-resource-pack",
                    "resource-pack-prompt=": "resource-pack-prompt"
                }
            }
        ]
    }
]
