Meta.DisplayName=Big Ambitions (Going Public server)
Meta.Description=Always-on Big Ambitions multiplayer host: the Going Public mod in headless server mode under Proton
Meta.OS=Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=amaus1209
Meta.URL=https://github.com/amaus1209/BigAmbitionsGoingPublicServer
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/amaus1209/BigAmbitionsGoingPublicServer/main/logo.jpg
Meta.EndpointURIFormat=https://{ip}/monitor/{GenericModule.App.Ports.$GamePort}/index.html
Meta.ConfigManifest=bigambitionsconfig.json
Meta.MetaConfigManifest=bigambitionsmetaconfig.json
Meta.ConfigRoot=bigambitions.kvp
Meta.MinAMPVersion=2.6.2.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=https://github.com/amaus1209/BigAmbitionsGoingPublicServer#server-owners-amp
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["python3","xvfb","xauth"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Going Public Server - dedicated server for Big Ambitions.
Meta.BreakingReleaseNotes=
Meta.ImportableExtensions=[]
Meta.AppConfigId=6b0c6a3e-9d1f-4a5e-8c2b-2f6d1e7a4b90
Meta.AppIsMultiIPAware=False
App.DisplayName=Big Ambitions
App.RootDir=./bigambitions/
App.BaseDirectory=./bigambitions/1331550/
App.SteamWorkshopDownloadLocation=
App.StoresSupported=SteamWorkshop
App.StoreDownloadLocations={"SteamWorkshop":"{{$FullRootDir}}bamp-mods-extra"}
App.ExecutableWin=1331550\Big Ambitions.exe
App.ExecutableLinux=/usr/bin/xvfb-run
App.WorkingDir=1331550
App.LinuxCommandLineArgs=-a "{{$FullRootDir}}.proton/proton" runinprefix "{{$FullBaseDir}}Big Ambitions.exe" -batchmode -nographics -bamp-config "Z:{{$FullBaseDir}}bamp-server.json" -bamp-headless-dir "Z:{{$FullRootDir}}headless"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"SteamAppId": "1331550", "SteamGameId": "1331550", "STEAM_COMPAT_DATA_PATH": "{{$FullRootDir}}.proton/compatdata", "STEAM_COMPAT_CLIENT_INSTALL_PATH": "{{$FullBaseDir}}.steam/steam", "HOME": "{{$FullBaseDir}}", "LD_LIBRARY_PATH": "{{$FullRootDir}}linux64:%LD_LIBRARY_PATH%", "WINEDLLOVERRIDES": "winhttp=n,b"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=150
App.ExitString=stop warn
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[bigambitionsports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=8
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=status
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[bigambitionsupdates.json]
App.PreStartStages=@IncludeJson[bigambitionsstart.json]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=True
App.RapidStartup=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=^.*Big Ambitions\.exe.*$
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=(\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+)
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(?!.*\[BAMP-HEADLESS\]).*(Shader|wine: |fixme:|AsyncGPUReadback|does not support asynchronous readback|Compressed to C:|Game C:/users/steamuser/AppData/Local/Temp).*$
Console.AppReadyRegex=^.*\[BAMP-HEADLESS\] READY .*$
Console.UserJoinRegex=^.*\[BAMP-HEADLESS\] JOIN (?<username>.+)$
Console.UserLeaveRegex=^.*\[BAMP-HEADLESS\] LEAVE (?<username>.+)$
Console.UserChatRegex=^.*\[BAMP-HEADLESS\] CHAT (?<username>[^:]+): (?<message>.+)$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=^$
Console.ServerInfoRegex=^.*\[Server\] Info: (?:Port=(?<Spiel_Port>\S+) \| )?Schluessel=(?<Server_Password>\S+) \| Version=(?<Server_Version>\S+)(?: \| Admin=(?<Admin_Seite>\S+))?$
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={"Kick":"kick ${Name}","Ban":"ban ${Name}"}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
