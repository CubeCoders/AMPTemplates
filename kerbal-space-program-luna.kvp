Console.AppReadyRegex=^\[\d{2}:\d{2}:\d{2}\]\[LMP\]:\s+All\s+systems\s+up\s+and\s+running\..*$
Console.UserJoinRegex=^\[\d{2}:\d{2}:\d{2}\]\[LMP\]: Client (?<username>.+?) \((?<userid>[a-fA-F0-9]+)\) handshake successful, LMP Version: [\d.]+, KSP Version: [\d.]+$
Console.UserLeaveRegex=^\[\d{2}:\d{2}:\d{2}\]\[Debug\]: (?<username>.+?) sent Connection end message, reason: .+$
Console.UserChatRegex=^\[\d{2}:\d{2}:\d{2}\]\[Chat\]: (?<username>[^:]+): (?<message>.+)$
Console.UpdateAvailableRegex=
Console.PreConnectRegex=
Console.ConnectIPRegex=^\[\d{2}:\d{2}:\d{2}\]\[LMP\]: New client Connection from (?:(?:::ffff:)?(?<ip>(?:\d{1,3}\.){3}\d{1,3})):\d+$
Console.MetricsRegex=
Console.ServerInfoRegex=^\[\d{2}:\d{2}:\d{2}\]\[LMP\]: Luna Server version: (?<Version>[^\s]+) \(.+\)$
