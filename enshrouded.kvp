Meta.DisplayName=Enshrouded
Meta.Description=Enshrouded Dedicated Server
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Greelan, Shinynecrid
Meta.URL=https://enshrouded.com/
Meta.DisplayImageSource=url:https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1203620/7b462e81072e94d96cb4242a75f8adddd9ec1cbd/header.jpg
Meta.EndpointURIFormat=steam://connect/{ip}:{GenericModule.App.Ports.$QueryPort}
Meta.ConfigManifest=enshroudedconfig.json
Meta.MetaConfigManifest=enshroudedmetaconfig.json
Meta.ConfigRoot=enshrouded.kvp
Meta.MinAMPVersion=2.6.2.8
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=The server requires Wine (ideally latest stable from winehq.org) to run on Linux. Using a container avoids the need for you to install this dependency on the host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=13
Meta.ReleaseNotes=Enshrouded 1.0: adds the Automatic option to Enemy Amount and the Flame Altar Shroud Level setting. Limits now match the game: Diving Time Factor minimum 0.75, Enemy Damage Factor maximum 2.5, Boss Health Modifier maximum 4.
Meta.BreakingReleaseNotes=Linux now uses Wine instead of Proton GE. Existing container instances: change the image to cubecoders/ampbase:wine-stable. Native hosts: install Wine. Until then the old Proton GE install keeps working but is no longer updated. Proton saves are copied into the Wine prefix; .proton/compatdata is kept.
Meta.ImportableExtensions=[]
Meta.AppConfigId=473ef3af-bc0b-4555-a42b-9f6393ffd29f
Meta.AppIsMultiIPAware=False
App.DisplayName=Enshrouded
App.RootDir=./enshrouded/
App.BaseDirectory=./enshrouded/2278520/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=2278520\enshrouded_server.exe
App.ExecutableLinux=/bin/bash
App.WorkingDir=2278520
App.LinuxCommandLineArgs=-c "if [[ -x /usr/bin/wine ]]; then exec /usr/bin/wine \"{{$FullBaseDir}}enshrouded_server.exe\" \"$@\"; elif [[ -x \"{{$FullRootDir}}.proton/proton\" ]]; then unset WINEPREFIX WINEARCH WINEDEBUG; export STEAM_COMPAT_DATA_PATH=\"{{$FullRootDir}}.proton/compatdata\" STEAM_COMPAT_CLIENT_INSTALL_PATH=\"{{$FullBaseDir}}.steam/steam\" HOME=\"{{$FullBaseDir}}\"; exec \"{{$FullRootDir}}.proton/proton\" runinprefix \"{{$FullBaseDir}}enshrouded_server.exe\" \"$@\"; else echo \"ERROR: Wine was not found at /usr/bin/wine, and this instance has no Proton GE runtime to fall back to.\"; exit 1; fi" amp-launch
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} {{$FormattedArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"LD_LIBRARY_PATH":"{{$FullRootDir}}linux64:%LD_LIBRARY_PATH%","SteamAppId":"1203620","WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all","WINEDLLOVERRIDES":"dbghelp=n,b"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[enshroudedports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=QueryPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=16
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[enshroudedupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=^.*{{$WineBaseDir}}enshrouded_server\.exe.*$
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=(\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+|ProtonFixes\[\d+\] WARN: Skipping fix execution\. We are probably running a unit test\.)
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(WARNING|ERROR): Shader.+$
Console.AppReadyRegex=^.*\[Session\] 'HostOnline' \(up\)!$
Console.UserJoinRegex=^.*\[server\] Player '(?<username>.+?)' logged in with Permissions:$
Console.UserLeaveRegex=^.*\[server\] Remove Player '(?<username>.+?)'$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^\[\d\d:\d\d:\d\d\] \[INFO\] A new server update is available! v[\d\.]+.$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
