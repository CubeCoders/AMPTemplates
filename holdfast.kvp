Meta.Arch=x86_64
Meta.Author=IceOfWraith
Meta.URL=https://store.steampowered.com/app/589290/
Meta.DisplayImageSource=steam:589290
Meta.EndpointURIFormat=steam://connect/{ip}:{GenericModule.App.Ports.$QueryPort}
Meta.ConfigManifest=holdfastconfig.json
Meta.MetaConfigManifest=holdfastmetaconfig.json
Meta.ConfigRoot=holdfast.kvp
Meta.MinAMPVersion=2.6.2.6
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Initial release
Meta.BreakingReleaseNotes=
Meta.AppConfigId=a6b6cd80-b75e-4870-b4a5-565daff4d8d7
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Holdfast: Nations At War
App.RootDir=./holdfast/
App.BaseDirectory=./holdfast/1424230/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=1424230\Holdfast NaW.exe
App.ExecutableLinux=1424230/Holdfast NaW
App.WorkingDir=1424230
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-startserver -batchmode -nographics --serverheadless -serverConfigFilePath serverconfig_amp.txt -logFile - -logArchivesDirectory logs_archive/ -p {{$GamePort}} -playersLogFilePath logs_playerlogin/playerlogin.txt -adminCommandsLogFilePath logs_adminactions/adminactions.txt -chatLogFilePath logs_chat/chatlog.txt -scoreboardLogFilePath logs_score/scorelog.txt -vacLogFilePath logs_vac/vaclog.txt {{$FormattedArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"LD_LIBRARY_PATH":"{{$FullBaseDir}}linux64"}
App.CommandLineParameterFormat=-{0} {1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=
App.ExitFile=app_exit.lck
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[holdfastports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=150
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.RCONSelectIPMethod=Default
App.TelnetLoginFormat=
App.TelnetNewLineType=Default
App.UpdateSources=@IncludeJson[holdfastupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua","*.txt"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.UseSteamQueryForStatus=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=</?color[^>]*>
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(?:The referenced script .+ is missing!|Unable to blit\. Shader is not yet initialized!|\s{2,}.+|Memory Statistics:|\[ALLOC_.+|Unloading \d+ [Uu]nused .+|Total: [\d.]+ ms .+|UnloadTime: .+|Added file monitor for .+|Unable to read lines from text file: Could not find file .+|\[PhysX\] .+|in: .*)$
Console.AppReadyRegex=^Finished loading map in [\d.]+$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=
Console.PreConnectRegex=
Console.ConnectIPRegex=
Console.MetricsRegex=
Console.HideFromConsoleRegex=
Console.SuppressLogAtStart=False
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
