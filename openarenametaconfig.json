[
    {
        "ConfigFile": "baseoa/amp.cfg",
        "ConfigType": "kvp",
        "AutoMap": false,
        "ConfigFormat": "{0} \"{1}\"",
        "Subsections": [
            {
                "Heading": "$root",
                "SettingMappings": {
                    "//": "This file is controlled by AMP and is rewritten on every start\n// Put any other settings, such as a map rotation, in server.cfg",
                    "set sv_hostname": "sv_hostname",
                    "set g_motd": "g_motd",
                    "set g_password": "g_password",
                    "set sv_maxclients": "$MaxUsers",
                    "set g_gametype": "g_gametype",
                    "set fraglimit": "fraglimit",
                    "set timelimit": "timelimit",
                    "set capturelimit": "capturelimit",
                    "set g_friendlyfire": "g_friendlyfire",
                    "set g_allowVote": "g_allowVote",
                    "set bot_enable": "bot_enable",
                    "set bot_minplayers": "bot_minplayers",
                    "set g_spskill": "g_spskill",
                    "set sv_pure": "sv_pure",
                    "set sv_allowDownload": "sv_allowDownload",
                    "set sv_floodProtect": "sv_floodProtect",
                    "set g_log": "games.log",
                    "exec": "server.cfg"
                }
            }
        ]
    }
]
