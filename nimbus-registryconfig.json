    {
        "DisplayName": "Let AMP Manage nimbus.registry.toml",
        "Category": "Updates",
        "Subcategory": "Nimbus Updates:build:-1",
        "Description": "When on, AMP rewrites Nimbus.Registry/nimbus.registry.toml from the settings in this panel every time the instance starts. Turn it off to hand-edit that file instead.",
