[
    {
        "ConfigFile": "main/amp_server.cfg",
        "AutoMap": false,
        "ConfigType": "kvp",
        "ConfigFormat": "{0} \"{1}\"",
        "Subsections": [
            {
                "Heading": "$root",
                "SettingMappings": {
                    "//": "This file is controlled by AMP and rewritten on every start. Put other settings in server.cfg",
                    "set sv_hostname": "sv_hostname",
                    "set g_gametype": "g_gametype",
                    "set g_password": "g_password",
                    "set sv_privateclients": "sv_privateclients",
                    "set sv_privatepassword": "sv_privatepassword",
                    "set sv_maplist": "sv_maplist",
                    "set timelimit": "timelimit",
                    "set fraglimit": "fraglimit",
                    "set roundlimit": "roundlimit",
                    "set g_teamdamage": "g_teamdamage",
                    "set g_healthdrop": "g_healthdrop",
                    "set sv_sprinton": "sv_sprinton",
                    "set g_inactivespectate": "g_inactivespectate",
                    "set g_inactivekick": "g_inactivekick",
                    "set g_teamkillwarn": "g_teamkillwarn",
                    "set g_teamkillkick": "g_teamkillkick",
                    "set g_teamswitchdelay": "g_teamswitchdelay",
                    "set g_allowjointime": "g_allowjointime",
                    "set sv_floodprotect": "sv_floodprotect",
                    "set sv_maxping": "sv_maxping",
                    "set sv_keywords": "sv_keywords",
                    "exec": "server.cfg"
                }
            }
        ]
    }
]
