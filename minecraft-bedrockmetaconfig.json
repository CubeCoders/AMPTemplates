[
    {
        "ConfigFile": "server.properties",
        "ConfigType": "kvp",
        "ConfigFormat": "{0}{1}",
        "Importable": true,
        "Subsections": [
            {
                "Heading": "$root",
                "SettingMappings": {
                    "server-name=": "server-name",
                    "gamemode=": "gamemode",
                    "force-gamemode=": "force-gamemode",
                    "difficulty=": "difficulty",
                    "allow-cheats=": "allow-cheats",
                    "max-players=": "$MaxUsers",
                    "online-mode=": "online-mode",
                    "allow-list=": "allow-list",
                    "server-port=": "$ServerPortv4",
                    "server-portv6=": "$ServerPortv6",
                    "enable-lan-visibility=": "enable-lan-visibility",
                    "view-distance=": "view-distance",
                    "tick-distance=": "tick-distance",
                    "player-idle-timeout=": "player-idle-timeout",
                    "max-threads=": "max-threads",
                    "level-name=": "level-name",
                    "level-seed=": "level-seed",
                    "level-type=": "level-type",
                    "default-player-permission-level=": "default-player-permission-level",
                    "texturepack-required=": "texturepack-required",
                    "content-log-file-enabled=": "content-log-file-enabled",
                    "compression-threshold=": "compression-threshold",
                    "compression-algorithm=": "compression-algorithm",
                    "player-position-acceptance-threshold=": "player-position-acceptance-threshold",
                    "player-movement-action-direction-threshold=": "player-movement-action-direction-threshold",
                    "server-authoritative-block-breaking-pick-range-scalar=": "server-authoritative-block-breaking-pick-range-scalar",
                    "chat-restriction=": "chat-restriction",
                    "disable-player-interaction=": "disable-player-interaction",
                    "client-side-chunk-generation-enabled=": "client-side-chunk-generation-enabled",
                    "block-network-ids-are-hashes=": "block-network-ids-are-hashes",
                    "disable-persona=": "false",
                    "disable-custom-skins=": "disable-custom-skins",
                    "server-build-radius-ratio=": "server-build-radius-ratio",
                    "allow-outbound-script-debugging=": "allow-outbound-script-debugging",
                    "allow-inbound-script-debugging=": "allow-inbound-script-debugging",
                    "force-inbound-debug-port=": "$DebuggerPort",
                    "script-debugger-auto-attach=": "script-debugger-auto-attach",
                    "script-debugger-auto-attach-connect-address=": "script-debugger-auto-attach-connect-address",
                    "transport=": "transport",
                    "server-udp-ports=": "$UDPTransportPortRange",
                    "allow-player-joining=": "allow-player-joining",
                    "content-log-console-output-enabled=": "content-log-console-output-enabled",
                    "content-log-level=": "content-log-level",
                    "server-authoritative-movement-strict=": "server-authoritative-movement-strict",
                    "server-authoritative-dismount-strict=": "server-authoritative-dismount-strict",
                    "server-authoritative-entity-interactions-strict=": "server-authoritative-entity-interactions-strict",
                    "disable-client-vibrant-visuals=": "disable-client-vibrant-visuals",
                    "script-debugger-listen-address=": "script-debugger-listen-address",
                    "script-debugger-auto-attach-timeout=": "script-debugger-auto-attach-timeout",
                    "script-debugger-passcode=": "script-debugger-passcode",
                    "script-watchdog-enable=": "script-watchdog-enable",
                    "script-watchdog-enable-exception-handling=": "script-watchdog-enable-exception-handling",
                    "script-watchdog-enable-shutdown=": "script-watchdog-enable-shutdown",
                    "script-watchdog-hang-exception=": "script-watchdog-hang-exception",
                    "script-watchdog-hang-threshold=": "script-watchdog-hang-threshold",
                    "script-watchdog-spike-threshold=": "script-watchdog-spike-threshold",
                    "script-watchdog-slow-threshold=": "script-watchdog-slow-threshold",
                    "script-watchdog-memory-warning=": "script-watchdog-memory-warning",
                    "script-watchdog-memory-limit=": "script-watchdog-memory-limit",
                    "diagnostics-capture-auto-start=": "diagnostics-capture-auto-start",
                    "diagnostics-capture-max-files=": "diagnostics-capture-max-files",
                    "diagnostics-capture-max-file-size=": "diagnostics-capture-max-file-size",
                    "enable-editor-network-metrics=": "enable-editor-network-metrics",
                    "sentry-rate-limit-window=": "sentry-rate-limit-window",
                    "sentry-max-events-per-window=": "sentry-max-events-per-window",
                    "persistent-ticking-area-max-count=": "persistent-ticking-area-max-count",
                    "persistent-ticking-area-max-chunks=": "persistent-ticking-area-max-chunks",
                    "transient-ticking-area-max-chunks=": "transient-ticking-area-max-chunks",
                    "server-authoritative-block-breaking=": "server-authoritative-block-breaking",
                    "emit-server-telemetry=": "emit-server-telemetry",
                    "": "UserSettings"
                }
            }
        ]
    }
]
