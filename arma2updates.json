        "UpdateSourceArgs": "BEServer.dll",
        "UpdateSourceTarget": "{{$FullBaseDir}}BattlEye",
        "OverwriteExistingFiles": true,
        "SkipOnFailure": true
    },
    {
        "UpdateStageName": "Server Config Template Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://cdn-repo.c7rs.com/AMPTemplates/arma2server.cfg",
        "UpdateSourceArgs": "AMP_server.cfg",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "OverwriteExistingFiles": false,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Basic Config File Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://cdn-repo.c7rs.com/AMPTemplates/arma2basic.cfg",
        "UpdateSourceArgs": "basic.cfg",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "OverwriteExistingFiles": false,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Create Server Parameters File",
        "UpdateSourcePlatform": "All",
