    },
    {
        "UpdateStageName": "BattlEye Directory Creation",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"mkdir -p \\\"{{$FullBaseDir}}BattlEye\\\"\"",
