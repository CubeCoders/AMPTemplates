[
    {
        "ConfigFile": "Zomboid/Server/{{servername}}.ini",
        "AutoMap": true,
        "Importable": true,
        "ConfigType": "kvp",
        "ConfigFormatRegex": "^(?<key>.+?)=(?<value>.*?)$"
    },
    {
        "ConfigFile": "Zomboid/Server/{{servername}}_SandboxVars.lua",
        "AutoMap": true,
        "Importable": false,
        "ConfigType": "kvp",
        "ConfigFormat": "    {0} = {1},",
        "ConfigFormatRegex": "^\\s*(?<key>[A-Za-z0-9_]+)\\s*=\\s*(?<value>.*?),?\\s*$"
    }
]
