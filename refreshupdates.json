[
    {
        "UpdateStageName": "Refresh Download",
        "UpdateSourcePlatform": "Windows",
        "UpdateSource": "FetchURLFromJQ",
        "UpdateSourceData": "https://api.github.com/repos/LittleBigRefresh/Refresh/releases/latest",
        "UpdateSourceArgs": "$.assets[?(@.name =~ /^Refresh_for_Windows_x64\\.zip$/)].browser_download_url",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "UnzipUpdateSource": true,
        "OverwriteExistingFiles": true,
        "DeleteAfterExtract": true,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Refresh Download",
        "UpdateSourcePlatform": "Linux",
