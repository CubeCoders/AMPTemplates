    {
        "DisplayName": "Force Relay Only",
        "Category": "BetterCrewLink:mic",
        "Subcategory": "Peer Connections:settings_ethernet:2",
        "Description": "Routes all voice through TURN relays so players never connect to each other directly, hiding their IP addresses. Needs the integrated relay enabled",
