        "FieldName": "integratedRelay.enabled",
        "InputType": "checkbox",
        "ParamFieldName": "integratedRelay.enabled",
        "IncludeInCommandLine": false,
        "DefaultValue": "true",
        "EnumValues": {
            "False": "false",
            "True": "true"
        }
    },
