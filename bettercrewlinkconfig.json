        "FieldName": "forceRelayOnly",
        "InputType": "checkbox",
        "ParamFieldName": "forceRelayOnly",
        "IncludeInCommandLine": false,
        "DefaultValue": "false",
        "EnumValues": {
            "False": "false",
            "True": "true"
        }
    },
    {
        "DisplayName": "Enable Integrated Relay",
        "Category": "BetterCrewLink:mic",
        "Subcategory": "Peer Connections:settings_ethernet:2",
