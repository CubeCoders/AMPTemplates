Meta.DisplayName=Mount & Blade II: Bannerlord Co-op
Meta.Description=Co-op campaign dedicated server for Linux Docker using Wine. Experimental template.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=ZifeRRoT
Meta.URL=https://github.com/Bannerlord-Coop-Team/BannerlordCoop
Meta.DisplayImageSource=steam:261550
Meta.ConfigManifest=mount-and-blade2-coopconfig.json
Meta.MetaConfigManifest=mount-and-blade2-coopmetaconfig.json
Meta.ConfigRoot=mount-and-blade2-coop.kvp
Meta.MinAMPVersion=2.8.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=RecommendedOnLinux
Meta.ContainerPolicyReason=The AMP Wine image provides Wine, Xvfb, socat and jq. Native Linux requires these dependencies on the host.
Meta.ExtraContainerPackages=[]
Meta.ConfigVersion=12
Meta.AppConfigId=7b025c72-f27d-4fcf-bced-9b4ad2964dac
App.DisplayName=Mount & Blade II: Bannerlord Co-op
App.RootDir=./bannerlord-coop/
App.BaseDirectory=./bannerlord-coop/
App.ExecutableLinux=/usr/bin/env
App.WorkingDir=server/engine/bin/Win64_Shipping_Server
App.LinuxCommandLineArgs="BANNERLORD_USER_DIR=Z:{{$FullRootDir}}data" "COOP_DATA_DIR=Z:{{$FullRootDir}}data" "DOTNET_ROOT=Z:{{$FullRootDir}}server/engine/dotnet" /usr/bin/xvfb-run -a /usr/bin/socat STDIO "EXEC:/usr/bin/wine ../../dotnet/dotnet.exe TaleWorlds.Starter.DotNetCore.dll _MODULES_*Native*SandBoxCore*Sandbox*{{CoopModuleId}}*DedicatedServer.Windows*_MODULES_ /dedicatedcustomserver {{$EnginePort}} EU 0,pty,setsid,ctty,echo=0,inlcr"
App.CommandLineArgs={{$PlatformArgs}}
App.UseLinuxIOREDIR=False
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all","WINEDLLOVERRIDES":"mscoree,mshtml=","BANNERLORD_USER_DIR":"{{$FullRootDir}}data","COOP_DATA_DIR":"{{$FullRootDir}}data","DOTNET_ROOT":"{{$FullRootDir}}server/engine/dotnet","DOTNET_MULTILEVEL_LOOKUP":"0","DS_ACCEPT_EULA":"{{AcceptEULA}}"}
App.AppSettings={"CoopModuleId":"Coop"}
App.ExitMethod=String
App.ExitString=stop
App.ExitTimeout=180
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.AdminMethod=STDIO
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[mount-and-blade2-coopports.json]
App.PrimaryApplicationPortRef=GamePort
App.AdminPortRef=0
App.UpdateSources=@IncludeJson[mount-and-blade2-coopupdates.json]
App.PreStartStages=@IncludeJson[mount-and-blade2-coopstart.json]
App.MonitorDirectChildOnly=False
App.MonitorChildProcessName=^(?:"?[A-Za-z]:[\\/].*?dotnet\.exe"?|(?:\.\./)+dotnet/dotnet\.exe|dotnet\.exe)\s+.*TaleWorlds\.Starter\.DotNetCore\.dll.* /dedicatedcustomserver {{$EnginePort}} EU 0\s*$
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=True
App.SupportsUniversalSleep=False
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^.*coop server up, waiting for clients.*$
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.SuppressLogAtStart=False
Console.UserActions={}
Limits.SleepMode=False
Limits.AutoRetryCount=0
