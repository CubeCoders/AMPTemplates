Meta.DisplayName=Renegade X
Meta.Description=Renegade X Dedicated Server
Meta.OS=Windows, Linux
Meta.AarchSupport=NotSupported
Meta.Arch=x86_64
Meta.Author=egtechgeek,fffreak9999,Greelan,IceOfWraith
Meta.URL=https://totemarts.games/
Meta.DisplayImageSource=url:https://files.totemarts.games/monthly_2023_03/game-Renegade-X.png.4719e918a358593480836893c170677f.png
Meta.EndpointURIFormat= 
Meta.ConfigManifest=renegadexconfig.json
Meta.MetaConfigManifest=renegadexmetaconfig.json
Meta.ConfigRoot=renegadex.kvp
Meta.MinAMPVersion=2.7.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=The server requires Wine, Xvfb, cabextract and Xdelta3 to install and run on Linux. Using a container avoids the need for you to install these dependencies on the host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["xdelta3"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.AppConfigId=6e1056fe-9e37-49cf-a1cd-e4a8aaf1a74e
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Renegade X
App.RootDir=./renegadex/
App.BaseDirectory=./renegadex/server/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=server\Binaries\Win64\UDK.exe
App.ExecutableLinux=/usr/bin/xvfb-run
App.WorkingDir=server/Binaries/Win64
App.LinuxCommandLineArgs=-a wine "./UDK.exe"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} server {{Map}}?maxplayers={{$MaxUsers}}{{$FormattedArgs}} -Port={{$ServerPort}} -MultiHome={{$ApplicationIPBinding}} -log -forcelogflush
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=?{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitMethodWindows=Kill
App.ExitTimeout=15
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=False
App.HasReadableConsole=True
Meta.ImportableExtensions=[]
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[renegadexports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=40
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=TailLogFile
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.TelnetLoginFormat={0}
App.TailLogFilePath={{$FullBaseDir}}UDKGame/Logs/Launch.log
App.UpdateSources=@IncludeJson[renegadexupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=^{{$WineBaseDir}}Binaries\\Win64\\UDK\.exe.*-Port={{$ServerPort}}.*$
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=\x02
Console.FilterMatchReplacement=|
Console.ThrowawayMessageRegex=^\[[\d.]+\] (?:Log: (?:WARNING: Cooking Convex For Actor|!+\s+CPU skinned|MIC::Set)|TPS DT:).*$|^X connection to :\d+ broken.*$
Console.AppReadyRegex=^\[[\d.]+\] Log: Bringing World .+ up for play .*$
Console.UserJoinRegex=^\[[\d.]+\] Rx: PLAYER\|Enter;\|[^,|]*,(?<userid>\d+),(?<username>[^|\r]+)\|from\|(?<endpoint>[^|\r]+)\|.*$
Console.UserLeaveRegex=^\[[\d.]+\] Rx: PLAYER\|Exit;\|[^,|]*,(?<userid>\d+),(?<username>[^|\r]+)\r?$
Console.UserChatRegex=^\[[\d.]+\] Rx: CHAT\|(?:Say|TeamSay);\|[^,|]*,\d+,(?<username>[^|\r]+)\|said:\|(?<message>.*?)\r?$
Console.UpdateAvailableRegex=^$
Console.DownloadProgressRegex=^Verify: .+, Download: \d+/\d+ \(100%.+, Apply: \d+/\d+ \((?<ProgressPercent>[\d.]+)%|^Verify: .+, Download: \d+/\d+ \((?<ProgressPercent>[\d.]+)%
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
