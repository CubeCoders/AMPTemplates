    {
        "DisplayName": "DLC Product Keys",
        "Category": "Farming Simulator 25:agriculture",
        "Subcategory": "DLCs:extension:0",
        "Description": "Optional named GIANTS DLC keys, one per line or separated by semicolons: pumps=KEY;mercedes=KEY. Names may contain letters, numbers, underscores and hyphens; use the same names in DLC Installation Sources. Visible to AMP users who can view this setting. Leave empty for base-game-only servers. Run Update while stopped after changing keys or sources, then start. Removing an entry does not uninstall its DLC",
        "Keywords": "dlc,product,key,expansion,activation",
        "FieldName": "DLCProductKeysList",
        "InputType": "textarea",
        "IsFlagArgument": false,
        "ParamFieldName": "DLCProductKeysList",
        "IncludeInCommandLine": false,
        "DefaultValue": "",
        "Placeholder": "pumps=XXXXX-XXXXX-XXXXX-XXXXX\nmercedes=XXXXX-XXXXX-XXXXX-XXXXX",
        "EnumValues": {}
    },
    {
        "DisplayName": "DLC Installation Sources",
        "Category": "Farming Simulator 25:agriculture",
        "Subcategory": "DLCs:extension:0",
        "Description": "Optional download overrides, one per line: pumps=https://.../installer.exe or mercedes=uploaded-installer.img. Upload local files into the dlc-installers folder of this instance; subfolders are supported. Each name must match one in DLC Product Keys. Without an override, the key's FS25 DLC downloads are looked up at the GIANTS download portal. Accepts Windows EXE installers and ISO9660/UDF IMG images, not portal pages or installed .dlc files",
        "Keywords": "dlc,download,url,link,img,exe,upload,installer",
        "FieldName": "DLCInstallSources",
        "InputType": "textarea",
        "IsFlagArgument": false,
        "ParamFieldName": "DLCInstallSources",
        "IncludeInCommandLine": false,
        "DefaultValue": "",
        "Placeholder": "pumps=https://.../installer.exe\nmercedes=uploaded-installer.img",
        "EnumValues": {}
    },
    {
        "DisplayName": "DLC Installer Timeout",
        "Category": "Farming Simulator 25:agriculture",
        "Subcategory": "DLCs:extension:0",
        "Description": "Maximum seconds per DLC installer, including online activation. A timeout fails the start without marking that DLC installed. Installing a DLC does not enable it on a savegame; select it in the GIANTS web interface",
