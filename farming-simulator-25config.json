    {
        "DisplayName": "DLC Product Keys (Legacy)",
        "Category": "Farming Simulator 25:agriculture",
        "Subcategory": "DLCs:extension:0",
        "Description": "Optional GIANTS DLC keys: key_1=KEY;key_2=KEY;key_3=KEY. Names may contain letters, numbers, underscores and hyphens. Use the same names in DLC Installation Sources. Entries may also be on separate lines. Update and startup read the saved AMP settings directly; product keys are not passed in the Python command line. Leave empty for base-game-only operation. Run Update while stopped after changing keys or sources, then start. Removing an entry does not uninstall its DLC",
        "Keywords": "dlc,product,key,expansion,activation",
        "FieldName": "DLCProductKeys",
        "InputType": "Password",
        "IsFlagArgument": false,
        "ParamFieldName": "DLCProductKeys",
        "IncludeInCommandLine": false,
        "DefaultValue": "",
        "Required": false,
        "Placeholder": "DLC_A=XXXXX-XXXXX-XXXXX-XXXXX;DLC_B=XXXXX-XXXXX-XXXXX-XXXXX",
        "EnumValues": {},
        "Hidden": true
    },
    {
        "DisplayName": "DLC Product Keys (List)",
        "Category": "Farming Simulator 25:agriculture",
        "Subcategory": "DLCs:extension:0",
        "Description": "Optional named GIANTS DLC keys, one per line or separated by semicolons: pumps=KEY;mercedes=KEY. These entries are visible to AMP users allowed to view this setting. This list replaces the legacy masked multi-key password field so existing entries remain editable. Use matching names in DLC Installation Sources. Leave blank when no DLCs are used. Run Update while the game is stopped after changing keys or sources, then Start. Removing an entry does not uninstall its DLC.",
        "Keywords": "dlc,product,key,expansion,activation",
        "FieldName": "DLCProductKeysList",
        "InputType": "Textarea",
        "IsFlagArgument": false,
        "ParamFieldName": "DLCProductKeysList",
        "IncludeInCommandLine": false,
        "DefaultValue": "",
        "Required": false,
        "Placeholder": "pumps=XXXXX-XXXXX-XXXXX-XXXXX\nmercedes=XXXXX-XXXXX-XXXXX-XXXXX",
        "EnumValues": {}
    },
    {
        "DisplayName": "DLC Installation Sources (Optional)",
        "Category": "Farming Simulator 25:agriculture",
        "Subcategory": "DLCs:extension:0",
        "Description": "Optional download overrides, one per line: DLC_A=https://.../installer.exe or DLC_B=uploaded-installer.img. Upload local files into the dlc-installers folder inside this FS25 instance; subfolders are supported. Match each name to DLC Product Keys (List). Omit a source to discover that key's FS25 DLC downloads at GIANTS. Sources accept Windows EXE installers and ISO9660/UDF IMG images, not portal pages or installed .dlc files. An override selects that package only; use separate names for additional packages sharing a key. URLs and uploaded files stay pinned until you change them or remove the override",
        "Keywords": "dlc,download,url,link,img,exe,upload,installer",
        "FieldName": "DLCInstallSources",
        "InputType": "Textarea",
        "IsFlagArgument": false,
        "ParamFieldName": "DLCInstallSources",
        "IncludeInCommandLine": false,
        "DefaultValue": "",
        "Required": false,
        "Placeholder": "DLC_A=https://.../installer.exe\nDLC_B=uploaded-installer.img",
        "EnumValues": {}
    },
    {
        "DisplayName": "DLC Installer Timeout",
        "Category": "Farming Simulator 25:agriculture",
        "Subcategory": "DLCs:extension:0",
        "Description": "Maximum seconds per DLC installer, including online activation. A timeout fails the start without marking that DLC installed. Installation does not automatically select DLCs for a savegame; select the desired content in the GIANTS web interface",
