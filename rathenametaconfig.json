[
    {
        "ConfigFile": "server/conf/import/login_conf.txt",
        "ConfigType": "kvp",
        "AutoMap": false,
        "ConfigFormat": "{0}: {1}",
        "Subsections": [
            {
                "Heading": "$root",
                "SettingMappings": {
                    "bind_ip": "$ApplicationIPBinding",
                    "login_port": "$LoginPort",
                    "new_account": "NewAccount",
                    "console": "off"
                }
            }
        ]
    },
    {
        "ConfigFile": "server/conf/import/char_conf.txt",
        "ConfigType": "kvp",
        "AutoMap": false,
        "ConfigFormat": "{0}: {1}",
        "Subsections": [
            {
                "Heading": "$root",
                "SettingMappings": {
                    "userid": "InterServerUser",
                    "passwd": "InterServerPassword",
                    "server_name": "ServerName",
                    "login_ip": "127.0.0.1",
                    "login_port": "$LoginPort",
                    "char_ip": "PublicIP",
                    "bind_ip": "$ApplicationIPBinding",
                    "char_port": "$CharPort",
                    "console": "off"
                }
            }
        ]
    },
    {
        "ConfigFile": "server/conf/import/map_conf.txt",
        "ConfigType": "kvp",
        "AutoMap": false,
        "ConfigFormat": "{0}: {1}",
        "Subsections": [
            {
                "Heading": "$root",
                "SettingMappings": {
