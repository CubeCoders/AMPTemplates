[
    {
        "ConfigFile": "{{GameMode}}.txt",
        "ConfigType": "kvp",
        "AutoMap": true,
        "Importable": true,
        "ConfigFormat": "{0} {1}",
        "ConfigFormatRegex": "^(?:#)?(?<key>.+?) (?<value>.*?)$"
    },
    {
        "ConfigFile": "amp_start.txt",
        "ConfigType": "kvp",
        "ConfigFormat": "{0} {1}",
        "Subsections": [
            {
                "Heading": "$root",
                "SettingMappings": {
                    "set_steam_port": "$SteamPort",
                    "set_port": "$GamePort",
                    "read_command_file": "AMPGameModeFile"
                }
            }
        ]
    }
]
