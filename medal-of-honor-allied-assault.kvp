Meta.DisplayName=Medal of Honor: Allied Assault
Meta.Description=Medal of Honor: Allied Assault, Spearhead and Breakthrough dedicated server, powered by OpenMoHAA. Needs the game data from your own copy of the game.
Meta.OS=Windows, Linux
Meta.AarchSupport=NotSupported
Meta.Arch=x86_64
Meta.Author=amp-template-bot
Meta.URL=https://github.com/openmoh/openmohaa
Meta.DisplayImageSource=url:https://images.gog-statics.com/5c91eb2e789f75422df7dbd85964dddcd38d90102db901049c48882d1fce26a2.png
Meta.EndpointURIFormat=
Meta.ConfigManifest=medal-of-honor-allied-assaultconfig.json
Meta.MetaConfigManifest=medal-of-honor-allied-assaultmetaconfig.json
Meta.ConfigRoot=medal-of-honor-allied-assault.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=RequiredOnWindows
Meta.ContainerPolicyReason=The Windows build of OpenMoHAA only takes console commands from a real console window and shows errors as dialog boxes, which hang when run as a service, so the Linux build runs in a container on Windows
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Initial release
Meta.BreakingReleaseNotes=
Meta.AppConfigId=d8dc94a4-2383-481f-9ad4-bd50ba4b4f9e
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=True
App.DisplayName=Medal of Honor: Allied Assault
App.RootDir=./mohaa/
App.BaseDirectory=./mohaa/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=omohaaded
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=+set com_target_game {{com_target_game}} +set fs_basepath "{{$FullBaseDir}}." +set fs_homepath "{{$FullBaseDir}}." +set net_ip {{$ApplicationIPBinding}} +set net_port {{$GamePort}} +set net_gamespy_port {{$GameSpyPort}} +set sv_gamespy {{sv_gamespy}} +set sv_maxclients {{$MaxUsers}} +set rconpassword "{{$RemoteAdminPassword}}" {{CustomArgs}} +exec amp_server.cfg +map {{StartMap}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"LD_LIBRARY_PATH":"{{$FullBaseDir}}.:%LD_LIBRARY_PATH%"}
App.CommandLineParameterFormat=+set {0} "{1}"
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitTimeout=30
App.ExitString=quit
App.ExitFile=
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[medal-of-honor-allied-assaultports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=20
App.UseRandomAdminPassword=True
App.PersistRandomPassword=True
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=status
App.RCONSelectIPMethod=Default
App.TelnetLoginFormat={0}
App.TelnetNewLineType=Default
App.UpdateSources=@IncludeJson[medal-of-honor-allied-assaultupdates.json]
App.PreStartStages=@IncludeJson[medal-of-honor-allied-assaultstart.json]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=(\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+|\^\d)
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^$
Console.AppReadyRegex=^------ Server Initialization Complete ------.*$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.PreConnectRegex=
Console.ConnectIPRegex=
Console.MetricsRegex=
Console.HideFromConsoleRegex=
Console.SuppressLogAtStart=False
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
