[
    {
        "ConfigFile": "ConfigOverride.ini",
        "ConfigType": "ini",
        "ConfigFormat": "{0}={1}",
        "Importable": true,
        "Subsections": [
            {
                "Heading": "Logging",
                "SettingMappings": {
                    "EnableConsole": "true",
                    "ConsoleIncludeTimestamps": "true",
                    "ConsoleMinLevel": "Logging.ConsoleMinLevel",
                    "EnableFile": "Logging.EnableFile",
                    "HideSensitiveInformation": "Logging.HideSensitiveInformation"
                }
            },
            {
                "Heading": "Frontend",
                "SettingMappings": {
                    "BindIP": "$ApplicationIPBinding",
                    "Port": "$GamePort",
                    "PublicAddress": "Frontend.PublicAddress"
                }
            },
            {
                "Heading": "WebFrontend",
                "SettingMappings": {
                    "Address": "WebFrontend.Address",
                    "Port": "$WebPort",
                    "EnableLoginRateLimit": "WebFrontend.EnableLoginRateLimit",
                    "EnableDashboard": "WebFrontend.EnableDashboard"
                }
            },
            {
                "Heading": "PlayerManager",
                "SettingMappings": {
                    "UseJsonDBManager": "PlayerManager.UseJsonDBManager",
                    "AllowClientVersionMismatch": "PlayerManager.AllowClientVersionMismatch",
                    "UseWhitelist": "PlayerManager.UseWhitelist",
                    "ServerCapacity": "PlayerManager.ServerCapacity",
                    "ShowNewsOnLogin": "PlayerManager.ShowNewsOnLogin",
                    "NewsUrl": "PlayerManager.NewsUrl"
                }
            },
            {
                "Heading": "GroupingManager",
                "SettingMappings": {
                    "ServerName": "GroupingManager.ServerName",
                    "MotdText": "GroupingManager.MotdText"
                }
            },
            {
                "Heading": "CustomGameOptions",
                "SettingMappings": {
                    "AutosaveIntervalMinutes": "CustomGameOptions.AutosaveIntervalMinutes",
                    "AutoUnlockAvatars": "CustomGameOptions.AutoUnlockAvatars",
                    "AutoUnlockTeamUps": "CustomGameOptions.AutoUnlockTeamUps",
                    "DisableMovementPowerChargeCost": "CustomGameOptions.DisableMovementPowerChargeCost",
                    "EnableUltimatePrestige": "CustomGameOptions.EnableUltimatePrestige"
                }
            },
            {
                "Heading": "MTXStore",
                "SettingMappings": {
                    "GazillioniteBalanceForNewAccounts": "MTXStore.GazillioniteBalanceForNewAccounts"
                }
            }
        ]
    }
]
