        "UpdateSourceData": "https://codeberg.org/forgejo/forgejo/releases/download/v{{SpecificServerVersion}}/forgejo-{{SpecificServerVersion}}-linux-arm64",
        "UpdateSourceTarget": "{{$FullBaseDir}}forgejo-download",
