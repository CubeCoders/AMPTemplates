    {
        "UpdateStageName": "Forgejo Installation",
        "UpdateStageDescription": "Installs the downloaded binary, creates the data folders and writes a starting app.ini if there is none",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"cd \\\"{{$FullBaseDir}}\\\" && mkdir -p custom/conf data log && f=$(ls -1 forgejo-download/forgejo-* | head -n 1) && [ -n \\\"$f\\\" ] && mv -f \\\"$f\\\" forgejo && chmod +x forgejo && rm -rf forgejo-download && if [ ! -f custom/conf/app.ini ]; then printf '%s\\n' 'APP_NAME = Forgejo' '' '[server]' 'HTTP_ADDR = 0.0.0.0' 'HTTP_PORT = 3000' 'DOMAIN = localhost' 'ROOT_URL = http://localhost:3000/' 'START_SSH_SERVER = true' 'SSH_PORT = 2222' 'SSH_LISTEN_PORT = 2222' > custom/conf/app.ini; fi && ./forgejo --version\"",
        "SkipOnFailure": false
    }
]
