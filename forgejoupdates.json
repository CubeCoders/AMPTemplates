[
    {
        "UpdateStageName": "Prepare Download Folder",
        "UpdateStageDescription": "Creates an empty download folder, removing any leftover from an earlier update",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"rm -rf \\\"{{$FullBaseDir}}forgejo-download\\\" && mkdir -p \\\"{{$FullBaseDir}}forgejo-download\\\"\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Forgejo Download",
        "UpdateStageDescription": "Downloads the latest Forgejo release (amd64) from Codeberg",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "FetchURLfromJQ",
        "UpdateSourceData": "https://codeberg.org/api/v1/repos/forgejo/forgejo/releases/latest",
        "UpdateSourceArgs": "$.assets[?(@.name =~ /^forgejo-[\\d.]+-linux-amd64$/)].browser_download_url",
        "UpdateSourceTarget": "{{$FullBaseDir}}forgejo-download",
        "UpdateSourceArch": "x86_64",
        "UnzipUpdateSource": false,
        "OverwriteExistingFiles": true,
        "UpdateSourceConditionSetting": "ServerStream",
        "UpdateSourceConditionValue": "latest",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Forgejo Download",
        "UpdateStageDescription": "Downloads the latest Forgejo release (arm64) from Codeberg",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "FetchURLfromJQ",
        "UpdateSourceData": "https://codeberg.org/api/v1/repos/forgejo/forgejo/releases/latest",
        "UpdateSourceArgs": "$.assets[?(@.name =~ /^forgejo-[\\d.]+-linux-arm64$/)].browser_download_url",
        "UpdateSourceTarget": "{{$FullBaseDir}}forgejo-download",
        "UpdateSourceArch": "aarch64",
        "UnzipUpdateSource": false,
        "OverwriteExistingFiles": true,
        "UpdateSourceConditionSetting": "ServerStream",
