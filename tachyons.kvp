Meta.DisplayName=Tachyons
Meta.Description=Tachyons: Battles Across the Galaxy Dedicated Server
Meta.OS=Windows, Linux
Meta.AarchSupport=Native
Meta.Arch=All
Meta.Author=amp-template-bot
Meta.URL=https://spektor.itch.io/tachyon
Meta.DisplayImageSource=steam:1350310
Meta.EndpointURIFormat=
Meta.ConfigManifest=tachyonsconfig.json
Meta.MetaConfigManifest=tachyonsmetaconfig.json
Meta.ConfigRoot=tachyons.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.ContainerPolicy=RequiredOnWindows
Meta.ContainerPolicyReason=The server only reads console commands and saves on shutdown when it runs in a terminal. AMP provides one for it on Linux, so on Windows it runs in a Linux container.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["unzip"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Initial release
Meta.AppConfigId=9e4c6a1d-3b27-4f58-a6d2-7c18e0b5f493
App.DisplayName=Tachyons
App.RootDir=./tachyons/
App.BaseDirectory=./tachyons/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=java\bin\java.exe
App.ExecutableLinux=/usr/bin/script
App.WorkingDir=
App.LinuxCommandLineArgs=-qfec "java/bin/java -Djava.awt.headless=true {{CustomJavaArgs}} -jar TachyonsServer.jar" /dev/null
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=30
App.ExitString=/exit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat={0} {1}
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[tachyonsports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=32
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[tachyonsupdates.json]
App.PreStartStages=[]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.MonitorChildProcess=False
App.MonitorChildProcessWaitMs=100
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+|\r
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^\d\d:\d\d\s+INFO: \[kryonet\].*$
Console.AppReadyRegex=^SERVER STARTED\.\s*$
Console.UserJoinRegex=^(?<username>.+?) IS NOW ONLINE\s*$
Console.UserLeaveRegex=^(?<username>.+?) IS NOW OFFLINE\s*$
Console.UserChatRegex=^\[CHAT GLOBAL\] (?<username>.+?): (?<message>.*?)\s*$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
