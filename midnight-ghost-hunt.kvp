Meta.DisplayName=Midnight Ghost Hunt
Meta.Description=Midnight Ghost Hunt Dedicated Server
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=amp-template-bot
Meta.URL=https://store.steampowered.com/app/915810/Midnight_Ghost_Hunt/
Meta.DisplayImageSource=steam:915810
Meta.EndpointURIFormat=
Meta.ConfigManifest=midnight-ghost-huntconfig.json
Meta.MetaConfigManifest=midnight-ghost-huntmetaconfig.json
Meta.ConfigRoot=midnight-ghost-hunt.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=The server requires Wine (ideally latest stable from winehq.org) to run on Linux. Using a container avoids the need for you to install this dependency on the host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Initial release
Meta.BreakingReleaseNotes=
Meta.AppConfigId=192757a8-e6c0-4068-a4e0-3145f418d68b
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Midnight Ghost Hunt
App.RootDir=./midnight-ghost-hunt/
App.BaseDirectory=./midnight-ghost-hunt/1118810/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=1118810\MidnightGhostHunt\Binaries\Win64\MidnightGhostHuntServer-Win64-Shipping.exe
App.ExecutableLinux=/usr/bin/wine
App.WorkingDir=1118810
App.LinuxCommandLineArgs="./MidnightGhostHunt/Binaries/Win64/MidnightGhostHuntServer-Win64-Shipping.exe"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} -log -stdout -FullStdOutLogOutput -port={{$GamePort}} -BeaconPort={{$BeaconPort}} -Map="{{Map}}" -Gamename="{{GameName}}" -Gamemode="{{GameMode}}" -Region="{{Region}}" -BotDifficulty="{{BotDifficulty}}"{{NoBots}}{{NoAutobalance}} {{$FormattedArgs}} {{CustomArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"SteamAppId":"915810","WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=-{0}="{1}"
App.CommandLineParameterDelimiter= 
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[midnight-ghost-huntports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=12
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=Password123
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[midnight-ghost-huntupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=^{{$WineBaseDir}}MidnightGhostHunt\\Binaries\\Win64\\MidnightGhostHuntServer-Win64-Shipping\.exe.*-port={{$GamePort}}.*$
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^\[[\d.:-]+\]\[[\d ]+\]LogTemp: Warning: (LevelAlterations|LvlpropDamage): .*$
Console.AppReadyRegex=^\[[\d.:-]+\]\[[\d ]+\]LogBlueprintableOnlineBeacons: Beacon MGH_Beacon_C is now being hosted\.$
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
