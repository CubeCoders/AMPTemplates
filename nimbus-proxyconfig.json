    {
        "DisplayName": "Initial Connect Order",
        "Category": "Nimbus Proxy:hub",
        "Subcategory": "Listener:settings_input_antenna:1",
        "Description": "Comma separated backend ids tried in order when a player first joins the proxy. The first one that accepts the connection wins. Unknown ids are skipped with a warning.  (Config file key: try)",
