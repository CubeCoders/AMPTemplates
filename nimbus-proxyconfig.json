        "EnumValues": {}
    },
    {
        "DisplayName": "Backend Servers",
        "Category": "Nimbus:stadia_controller",
        "Subcategory": "Routing:swap_horiz:2",
        "Description": "Sets the backend pool as a TOML inline table. Each key is a backend ID that must match that backend's ServerId in its nimbus-server.json, and each value is its host:port. Format: { hub = \"127.0.0.1:42421\", survival = \"127.0.0.1:42422\" }",
        "Keywords": "backend,servers,pool,routing",
        "FieldName": "servers",
        "InputType": "text",
        "ParamFieldName": "servers",
        "DefaultValue": "{ default = \"127.0.0.1:42421\" }",
        "Placeholder": "{ hub = \"127.0.0.1:42421\", survival = \"127.0.0.1:42422\" }",
        "EnumValues": {}
    },
    {
        "DisplayName": "Try Order",
        "Category": "Nimbus:stadia_controller",
        "Subcategory": "Routing:swap_horiz:2",
        "Description": "Sets the backend IDs tried in order when a player connects, as a TOML array. Every ID must exist in Backend Servers. Format: [\"hub\", \"survival\"]",
        "Keywords": "try,order,fallback,routing",
        "FieldName": "try",
        "InputType": "text",
        "ParamFieldName": "try",
        "DefaultValue": "[\"default\"]",
        "Placeholder": "[\"hub\", \"survival\"]",
        "EnumValues": {}
    },
    {
        "DisplayName": "Whitelisted Backends",
