        "Keywords": "s3,secret key,credentials,auth,authentication,password,admin",
        "FieldName": "S3SecretKey",
        "InputType": "password",
        "IncludeInCommandLine": false,
        "DefaultValue": "",
        "EnumValues": {}
    },
    {
        "DisplayName": "S3 Config File",
        "Category": "SeaweedFS:storage",
        "Subcategory": "S3:key:2",
        "Description": "Path, relative to the seaweedfs folder, of an [S3 identities file](https://github.com/seaweedfs/seaweedfs/wiki/S3-Credentials) with access keys and per-bucket permissions. Overrides the access key settings above",
