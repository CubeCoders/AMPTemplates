        "FieldName": "S3AccessKey",
        "InputType": "text",
        "IncludeInCommandLine": false,
        "DefaultValue": "",
        "EnumValues": {}
    },
    {
        "DisplayName": "S3 Secret Key",
        "Category": "SeaweedFS:storage",
        "Subcategory": "S3:key:2",
