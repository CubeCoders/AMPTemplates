        "UpdateSourceArgs": "-NoProfile -Command \"$ProgressPreference='SilentlyContinue'; Set-Location -Path 'gtac'; if (Test-Path 'server.xml') { Remove-Item -Path 'setup/server.xml' -Force -ErrorAction SilentlyContinue }; if (Test-Path 'resources') { Remove-Item -Path 'setup/resources' -Recurse -Force -ErrorAction SilentlyContinue }; Copy-Item -Path 'setup/*' -Destination '.' -Recurse -Force; Remove-Item -Path 'setup' -Recurse -Force -ErrorAction SilentlyContinue\"",
        "SkipOnFailure": false
    },
