Meta.DisplayName=RabbitMQ
Meta.Description=RabbitMQ multi-protocol message broker (AMQP 0-9-1 and AMQP 1.0, with MQTT and STOMP plugins) and its management web UI
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=amp-template-bot
Meta.URL=https://www.rabbitmq.com/
Meta.DisplayImageSource=url:https://www.rabbitmq.com/img/rabbitmq-logo-with-name.svg
Meta.EndpointURIFormat=amqp://{ip}:{GenericModule.App.Ports.$ServerPort}
Meta.ConfigManifest=rabbitmqconfig.json
Meta.MetaConfigManifest=rabbitmqmetaconfig.json
Meta.ConfigRoot=rabbitmq.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=RabbitMQ needs Erlang/OTP 27 or newer on Linux. Using a container installs it automatically, so you do not need to install it on the host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["erlang-nox","xz-utils"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Initial release
Meta.BreakingReleaseNotes=
Meta.AppConfigId=3c3637a6-96f2-49e6-af61-95db74500c8d
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=True
