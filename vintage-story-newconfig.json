    {
        "DisplayName": "Server Build",
        "Category": "Updates",
        "Subcategory": "Server Updates:build:-1",
        "Description": "Sets which server build to install. Official is the standard Vintage Story dedicated server. [Stratum](https://github.com/StratumServer/Stratum) is a server-side performance fork that downloads and patches the official server itself on first run, and requires the 10.0 Dotnet Release Stream. Update the server after changing this setting",
        "Keywords": "server,build,stratum,official,fork",
        "FieldName": "ServerExecutable",
        "InputType": "enum",
        "ParamFieldName": "ServerExecutable",
        "IncludeInCommandLine": false,
        "DefaultValue": "VintagestoryServer",
        "EnumValues": {
            "VintagestoryServer": "Official (default)",
            "StratumServer": "Stratum (performance fork)"
        }
    },
    {
        "DisplayName": "Stratum Version",
        "Category": "Updates",
        "Subcategory": "Server Updates:build:-1",
        "Description": "Sets the [Stratum version](https://github.com/StratumServer/Stratum/releases) to install, without the leading v. Empty = latest stable release; pre-releases are only installed if named explicitly. Only used when Server Build is Stratum. Update the server after changing this setting",
        "Keywords": "stratum,version",
        "FieldName": "StratumVersion",
        "InputType": "text",
        "ParamFieldName": "StratumVersion",
        "IncludeInCommandLine": false,
        "DefaultValue": "",
        "Placeholder": "1.22.7-stratum.1.1",
        "EnumValues": {}
    },
    {
        "DisplayName": "Server Release Stream",
        "Category": "Updates",
        "Subcategory": "Server Updates:build:-1",
        "Description": "Sets the server release stream from which to install the latest server version (for Stable and Unstable only), unless a specific version is specified under Server Version. Update the server after changing this setting",
        "Keywords": "server,release,stream",
        "FieldName": "ServerReleaseStream",
        "InputType": "enum",
        "IsFlagArgument": false,
        "ParamFieldName": "ServerReleaseStream",
        "IncludeInCommandLine": false,
        "DefaultValue": "stable",
        "EnumValues": {
            "stable": "Stable (default)",
            "unstable": "Unstable",
            "pre": "Preview"
        }
    },
    {
        "DisplayName": "Server Version",
        "Category": "Updates",
        "Subcategory": "Server Updates:build:-1",
        "Description": "Sets the server version to install. Empty = latest version if Stable or Unstable is selected under Server Release Stream. For Preview, a version identifier must be specified. Minimum 1.18.8. For Linux ARM64, a corresponding [ARM64 experimental server version](https://github.com/anegostudios/VintagestoryServerArm64) must exist. Update the server after changing this setting",
        "Keywords": "server,version",
        "FieldName": "ServerVersion",
        "InputType": "text",
        "IsFlagArgument": false,
        "ParamFieldName": "ServerVersion",
        "IncludeInCommandLine": false,
        "DefaultValue": "",
        "Placeholder": "1.18.15 | 1.20.0-rc.1 | 1.20.0-pre.13",
        "EnumValues": {}
    },
