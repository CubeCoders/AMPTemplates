    {
        "DisplayName": "Enable Lite Mode",
        "Category": "Minekube Gate Proxy:stadia_controller",
        "Subcategory": "Server:dns:1",
        "Description": "Runs Gate as a lightweight reverse proxy that routes players by the hostname they connect with, using Lite Routes. Lite mode ignores Backend Servers, Fallback Server Try Order and player info forwarding, so backends must not require proxy forwarding.",
        "Keywords": "enable,lite,mode",
        "FieldName": "config.lite.enabled",
        "InputType": "checkbox",
        "ParamFieldName": "config.lite.enabled",
        "DefaultValue": "false",
        "EnumValues": {
            "False": "false",
            "True": "true"
        }
    },
    {
        "DisplayName": "Lite Routes",
        "Category": "Minekube Gate Proxy:stadia_controller",
        "Subcategory": "Server:dns:1",
        "Description": "Lite mode routes as a JSON array, matched in order, e.g. [{\"host\": \"play.example.com\", \"backend\": \"127.0.0.1:25567\"}, {\"host\": \"*\", \"backend\": \"127.0.0.1:25568\"}]. host and backend can also be arrays; optional keys include strategy, proxyProtocol, modifyVirtualHost and cachePingTTL. Must contain at least one route when Lite mode is enabled. See https://gate.minekube.com/guide/lite",
        "Keywords": "lite,routes,host,backend",
        "FieldName": "config.lite.routes",
        "InputType": "text",
        "Required": true,
        "ParamFieldName": "config.lite.routes",
        "DefaultValue": "[{\"host\": \"*\", \"backend\": \"127.0.0.1:25567\"}]",
        "Placeholder": "[{\"host\": \"*\", \"backend\": \"127.0.0.1:25567\"}]",
        "EnumValues": {}
    },
