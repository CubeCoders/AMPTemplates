                    "Lobby.AutoTriggerMapVote": "AutoTriggerMapVote",
                    "Settings.DefaultTimeLimit": "DefaultTimeLimit",
                    "Settings.DefaultScoreLimit": "DefaultScoreLimit",
                    "Settings.RespawnTime": "RespawnTime",
                    "Settings.SpawnProtectionTime": "SpawnProtectionTime",
                    "Settings.PlayerHealth": "PlayerHealth",
                    "Settings.AmmoCount": "AmmoCount",
                    "Settings.WindStrength": "WindStrength",
                    "Settings.SecondaryWeapons": "SecondaryWeapons",
                    "Settings.Pistols": "Pistols",
                    "Settings.Grenades": "Grenades",
                    "Settings.LandMines": "LandMines",
                    "Settings.TripMines": "TripMines",
                    "Settings.S-Mines": "SMines",
                    "Settings.TNT": "TNT",
                    "Settings.Panzerfausts": "Panzerfausts",
                    "Settings.HealthItems": "HealthItems",
                    "Settings.BulletTrails": "BulletTrails",
                    "Settings.AimAssist": "AimAssist",
                    "Settings.EmptyLungZoom": "EmptyLungZoom",
                    "Settings.SniperScopeGlint": "SniperScopeGlint",
                    "Settings.RadarThreats": "RadarThreats",
                    "Settings.DamageIndicators": "DamageIndicators",
                    "Settings.ShotTagging": "ShotTagging",
                    "Settings.BinoTagging": "BinoTagging",
                    "Settings.ShowPlayersKiller": "ShowPlayersKiller",
                    "Settings.SpectatorOverview": "SpectatorOverview",
                    "Settings.BulletCam": "BulletCam",
                    "Settings.Sprint": "Sprint",
                    "Settings.MeleeKills": "MeleeKills",
                    "Settings.BulletDrop": "BulletDrop",
                    "Settings.FriendlyFire": "FriendlyFire",
                    "Settings.OneShotKills": "OneShotKills",
                    "Settings.HeadshotsOnly": "HeadshotsOnly",
                    "Settings.SingleBulletReload": "SingleBulletReload",
                    "Settings.ForceRespawn": "ForceRespawn",
                    "Settings.SideSwapping": "SideSwapping",
                    "Settings.Autobalance": "Autobalance",
                    "Settings.SuddenDeath": "SuddenDeath",
                    "exec": "amp_maprotation.cfg",
                    "Server.Host": "//"
                }
            }
        ]
    },
    {
        "ConfigFile": "amp_rcon.cfg",
        "ConfigType": "kvp",
        "ConfigFormat": "{0} {1}",
        "Subsections": [
            {
                "Heading": "$root",
                "SettingMappings": {
                    "Rcon.IP": "RconIP",
                    "Rcon.Port": "$RconPort",
                    "Rcon.Password": "RconPassword",
                    "Rcon.Listen": "//"
                }
            }
        ]
    }
]
