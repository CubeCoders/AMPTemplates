[
    {
        "ConfigFile": "amp_server.cfg",
        "ConfigType": "kvp",
        "ConfigFormat": "{0} {1}",
        "Subsections": [
            {
                "Heading": "$root",
                "SettingMappings": {
                    "Server.Name": "ServerName",
                    "Server.MoTD": "MoTD",
                    "Lobby.Password": "LobbyPassword",
                    "Server.GamePort": "$GamePort",
                    "Server.LobbyPort": "$LobbyPort",
