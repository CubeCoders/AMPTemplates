Meta.DisplayName=LeviLamina
Meta.Description=LeviLamina Mod Loader for Minecraft Bedrock Dedicated Server
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Greelan
Meta.URL=https://lamina.levimc.org/
Meta.DisplayImageSource=url:https://levimc.org/logos/LeviLamina.webp
Meta.EndpointURIFormat={ip}:{GenericModule.App.Ports.$ServerPortv4}
Meta.ConfigManifest=levilaminaconfig.json
Meta.MetaConfigManifest=levilaminametaconfig.json
Meta.ConfigRoot=levilamina.kvp
Meta.MinAMPVersion=2.8.0.8
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=On Linux, lip runs the Windows server through its own copy of Wine, which needs the GnuTLS and Fontconfig libraries. Using a container avoids the need for you to install these on the host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=2
Meta.ReleaseNotes=Display image now uses the LeviLamina logo from levimc.org.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=43d87456-4783-4626-90e3-05a6d4ae70b9
Meta.ImportableExtensions=[]
App.DisplayName=LeviLamina
App.RootDir=./levilamina/
App.BaseDirectory=./levilamina/server/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=server\bedrock_server_mod.exe
App.ExecutableLinux=lip/lip
App.WorkingDir=server
App.LinuxCommandLineArgs=run
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"XDG_DATA_HOME":"{{$FullRootDir}}.lip/data","XDG_CACHE_HOME":"{{$FullRootDir}}.lip/cache","XDG_CONFIG_HOME":"{{$FullRootDir}}.lip/config","XDG_STATE_HOME":"{{$FullRootDir}}.lip/state","XDG_RUNTIME_DIR":"","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitTimeout=30
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=True
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[levilaminaports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPortv4
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=10
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=Password123
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[levilaminaupdates.json]
App.PreStartStages=@IncludeJson[levilaminastart.json]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=LinuxBufferedConsole
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.SmartExcludeSupported=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(WARNING|ERROR): Shader.+$
Console.AppReadyRegex=^[\d:.]+ IFO \[Server\] Server started in .+$
Console.UserJoinRegex=^[\d:.]+ IFO \[Server\] Player connected: (?<username>.+?), xuid: (?<userid>\d+?)$
Console.UserLeaveRegex=^[\d:.]+ IFO \[Server\] Player disconnected: (?<username>.+?), xuid: (?<userid>.+?), pfid: .*$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^\[\d\d:\d\d:\d\d\] \[INFO\] A new server update is available! v[\d\.]+.$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
