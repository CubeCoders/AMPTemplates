[
    {
        "ConfigFile": "RDS_Data/config/rds_config.ini",
        "AutoMap": false,
        "ConfigType": "ini",
        "ConfigFormat": "{0} = {1}",
        "Subsections": [
            {
                "Heading": "Authentication",
                "SettingMappings": {
                    "MasterPrivateKey": "MasterPrivateKey",
                    "SteamAPIKey": "SteamAPIKey"
                }
            },
            {
                "Heading": "General",
                "SettingMappings": {
                    "ServerName": "ServerName",
                    "Password": "Password",
                    "Whitelist": "Whitelist",
                    "MaxPlayers": "$MaxUsers",
                    "PVP": "PVP",
                    "GameMode": "GameMode",
                    "SleepMode": "SleepMode",
                    "EnforceMods": "EnforceMods",
                    "IconUrl": "IconUrl",
                    "BannerUrl": "BannerUrl",
                    "ShownInServerlist": "ShownInServerlist",
                    "RestartOnCrash": "RestartOnCrash"
                }
            },
            {
                "Heading": "Advanced",
                "SettingMappings": {
                    "NetworkingLayer": "NetworkingLayer",
                    "RTCPPort": "$RTCPPort",
                    "ConsolePort": "$ConsolePort",
                    "UpdateBranch": "UpdateBranch",
                    "MaxServerFPS": "MaxServerFPS",
                    "DisableSteamAuthentication": "DisableSteamAuthentication"
                }
            }
        ]
    }
]