Meta.DisplayName=Knockout City: Private Server Edition
Meta.Description=Knockout City Private Server Edition Dedicated Server
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Greelan
Meta.URL=https://www.knockoutcity.com/
Meta.DisplayImageSource=steam:2915930
Meta.EndpointURIFormat= 
Meta.ConfigManifest=knockout-cityconfig.json
Meta.MetaConfigManifest=knockout-citymetaconfig.json
Meta.ConfigRoot=knockout-city.kvp
Meta.MinAMPVersion=2.6.4.0
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=The server always keeps its database in the user profile and starts its own PostgreSQL and Redis on fixed ports, so instances outside a container would share data and clash. In a container it runs under Wine with its data kept inside the instance.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["postgresql","redis-server"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Initial release
Meta.BreakingReleaseNotes=
Meta.AppConfigId=09020e9d-06c2-411b-b6a6-ffaffb17e133
Meta.ImportableExtensions=[]
App.DisplayName=Knockout City
App.RootDir=./knockout-city/
App.BaseDirectory=./knockout-city/2915930/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=2915930\KnockoutCityServer\KnockoutCityServer.exe
App.ExecutableLinux=/usr/bin/wine
App.WorkingDir=/tmp/knockout-city-server
App.LinuxCommandLineArgs=KnockoutCityServer.exe -backend_db=postgresql://viper:viper@localhost:5434/viper -backend_redis_db_host=127.0.0.1 -backend_redis_db_port=6380
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} -backend_port={{$ServerPort1}} -server_min_port={{$ServerPort1}} -server_max_port={{$ServerPort3}} {{$FormattedArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"SteamAppId":"2915930","WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=quit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[knockout-cityports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort1
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=10
App.UseRandomAdminPassword=True
App.PersistRandomPassword=True
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.RCONSelectIPMethod=Default
App.TelnetLoginFormat= 
App.TelnetNewLineType=Default
App.UpdateSources=@IncludeJson[knockout-cityupdates.json]
App.PreStartStages=@IncludeJson[knockout-citystart.json]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=True
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.SmartExcludeSupported=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=^Z:\\tmp\\knockout-city-server\\KnockoutCityServer\.exe.*-backend_port={{$ServerPort1}}.*$
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(WARNING|ERROR): Shader.+$
Console.AppReadyRegex=^\[[\d-]+ [\d:\.]+\] .*: note: private_server: Ready to brawl\.$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.ServerInfoRegex=
Console.UpdateAvailableRegex=^\[\d\d:\d\d:\d\d\] \[INFO\] A new server update is available! v[\d\.]+.$
Console.PreConnectRegex=
Console.ConnectIPRegex=
Console.MetricsRegex=
Console.HideFromConsoleRegex=
Console.SuppressLogAtStart=False
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
