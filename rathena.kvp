Meta.DisplayName=Ragnarok Online (rAthena)
Meta.Description=rAthena Ragnarok Online server emulator, built from source with a bundled MariaDB database
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=amp-template-bot
Meta.URL=https://rathena.org/
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/rathena/rathena/refs/heads/master/doc/logo.png
Meta.EndpointURIFormat=
Meta.ConfigManifest=rathenaconfig.json
Meta.MetaConfigManifest=rathenametaconfig.json
Meta.ConfigRoot=rathena.kvp
Meta.MinAMPVersion=2.6.2.6
Meta.SpecificDockerImage=cubecoders/ampbase:debian-12
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=rAthena has no prebuilt server binaries, so it is compiled during install. The container provides the compiler, build libraries and the MariaDB database it needs.
Meta.ExtraSetupStepsURI=
Meta.Prerequsites=[]
Meta.ExtraContainerPackages=["gcc","g++","make","libmariadb-dev","libmariadb-dev-compat","zlib1g-dev","libpcre3-dev","mariadb-server"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=2
Meta.ReleaseNotes=Moved the start and build scripts out of the server folder so they cannot be edited from the File Manager
Meta.BreakingReleaseNotes=
Meta.AppConfigId=5f0b8f9e-2c4d-4b7a-9a3e-6d1c2e8f4a71
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Ragnarok Online (rAthena)
App.RootDir=./rathena/
App.BaseDirectory=./rathena/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=/bin/bash
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs="{{$FullInstanceDir}}rathenarun.sh"
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"RA_DB_PORT":"{{$DatabasePort}}","RA_DB_PASS":"{{DatabasePassword}}","RA_IS_USER":"{{InterServerUser}}","RA_IS_PASS":"{{InterServerPassword}}","RA_WEB":"{{EnableWebServer}}"}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=30
App.ExitString=exit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[rathenaports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=LoginPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=0
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[rathenaupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=LinuxBufferedConsole
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua","*.txt"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+|\r
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^\s*$
Console.AppReadyRegex=^\[Status\]: Server is 'ready' and listening on port '\d+'\.$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
