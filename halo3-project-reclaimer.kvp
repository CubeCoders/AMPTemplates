Meta.DisplayName=Halo 3 (Project Reclaimer Mod)
Meta.Description=Halo 3 Dedicated Server using the Project Reclaimer mod for Halo: The Master Chief Collection
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=Shinynecrid
Meta.URL=https://projectreclaimer.dev/
Meta.DisplayImageSource=steam:976730
Meta.EndpointURIFormat=
Meta.ConfigManifest=halo3-project-reclaimerconfig.json
Meta.MetaConfigManifest=halo3-project-reclaimermetaconfig.json
Meta.ConfigRoot=halo3-project-reclaimer.kvp
Meta.MinAMPVersion=2.6.2.8
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=The server requires Wine and Xvfb to run on Linux. Using a container avoids the need for you to install these dependencies on the host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=True
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=c14d68b6-7623-4b7f-baf2-ee54a0737ddc
Meta.AppIsMultiIPAware=False
App.DisplayName=Halo 3 (Project Reclaimer Mod)
App.RootDir=./halo3-project-reclaimer/
App.BaseDirectory=./halo3-project-reclaimer/
App.ExecutableWin=project-reclaimer-dedicated.exe
App.ExecutableLinux=/usr/bin/xvfb-run
App.WorkingDir=
App.LinuxCommandLineArgs=-a wine "./project-reclaimer-dedicated.exe"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} dedicated
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all","WINEDLLOVERRIDES":"mscoree,mshtml="}
App.CommandLineParameterFormat=--{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitMethodWindows=OS_CLOSE
App.ExitString=
App.ExitTimeout=10
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[halo3-project-reclaimerports.json]
App.PrimaryApplicationPortRef=GamePort
App.AdminPortRef=GamePort
App.MaxUsers=16
App.UseRandomAdminPassword=True
App.PersistRandomPassword=True
App.AdminMethod=SourceRCON
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.UpdateSources=@IncludeJson[halo3-project-reclaimerupdates.json]
App.PreStartStages=@IncludeJson[halo3-project-reclaimerstart.json]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=True
App.RapidStartup=False
App.MonitorChildProcessName=^[A-Za-z]:.*project-reclaimer-dedicated\.exe dedicated$
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RCONConnected
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=
Console.UserJoinRegex=^\[.*?\] (?<username>Player) connected from (?<endpoint>\S+) \(player ID (?<userid>[0-9a-f]{64}), ping \d+ ms\)\.$
Console.UserLeaveRegex=^\[.*?\] (?<username>Player) left the server\.$
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.ServerInfoRegex=
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
