        "FieldName": "UserIDRegex",
        "InputType": "enum",
        "ParamFieldName": "UserIDRegex",
        "DefaultValue": "(BOT|(?<userid>(?!BOT).+?))",
        "EnumValues": {
            "(BOT|(?<userid>(?!BOT).+?))": "Count bots as players (default)",
            "(?<userid>(?!BOT).+?)": "Don't count bots as players"
        }
    },
