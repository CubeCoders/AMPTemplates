    {
        "DisplayName": "Autosave Interval",
        "Category": "The Riftbreaker:stadia_controller",
        "Subcategory": "Server:dns:1",
        "Description": "Sets how often the game autosaves, counted in unpaused play time. Minimum 5; lower values are ignored and no periodic autosave happens. The server does not save when stopped or when the last player leaves, so progress since the last autosave is lost on every stop or restart. The server owner can also Quick Save in game, which saves on the server",
        "Keywords": "autosave,save,interval,timer,autosave_timer",
        "FieldName": "autosave_timer",
        "InputType": "number",
        "MinValue": "5",
        "ParamFieldName": "autosave_timer",
        "DefaultValue": "5",
        "Placeholder": "5",
        "Suffix": "minutes",
        "EnumValues": {}
    },
    {
        "DisplayName": "Load Latest Save",
        "Category": "The Riftbreaker:stadia_controller",
        "Subcategory": "Server:dns:1",
        "Description": "If set, each start resumes the newest save made in the selected Campaign Mode, or begins a new map if that mode has no saves yet. The game keeps only the 4 newest autosaves, shared across all Campaign Modes. Saves are stored in the-riftbreaker/saves/campaignV2",
        "Keywords": "save,load,latest,resume,continue,autosave",
        "FieldName": "AutoLoadLatestSave",
        "InputType": "checkbox",
        "ParamFieldName": "AutoLoadLatestSave",
        "DefaultValue": "True",
        "EnumValues": {
            "False": "False",
            "True": "True"
        }
    },
    {
        "DisplayName": "Load Save",
        "Category": "The Riftbreaker:stadia_controller",
        "Subcategory": "Server:dns:1",
        "Description": "Only used when Load Latest Save is disabled. Sets the name of an existing save to load, exactly as shown in game, such as 'Autosave: 2026.11.03 - 11:46'. If empty, every server start begins a new map. An invalid name, or a save the game has since rotated out, leaves the server stuck at startup",
        "Keywords": "save,load,mission_save",
        "FieldName": "mission_save",
        "InputType": "text",
        "ParamFieldName": "mission_save",
        "ExcludeFromImport": true,
        "DefaultValue": "",
