Meta.DisplayName=Farming Simulator 25
Meta.Description=Farming Simulator 25 Dedicated Server
Meta.OS=Windows, Linux
Meta.AarchSupport=NotSupported
Meta.Arch=x86_64
Meta.Author=IceOfWraith
Meta.URL=https://www.farming-simulator.com/
Meta.DisplayImageSource=steam:2300320
Meta.EndpointURIFormat=http://{ip}:{GenericModule.App.Ports.$WebInterfacePort}
Meta.ConfigManifest=farming-simulator-25config.json
Meta.MetaConfigManifest=farming-simulator-25metaconfig.json
Meta.ConfigRoot=farming-simulator-25.kvp
Meta.MinAMPVersion=2.6.0.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=RecommendedOnLinux, RequiredOnWindows
Meta.ContainerPolicyReason=The dedicated server does not complete startup as NETWORK SERVICE on Windows, and the game hardcodes its savegame path under the running user's profile rather than the instance. Running it under Proton in a container avoids both, and keeps the savegames inside the instance.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["xdotool"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=True
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=0245cfc5-5fb5-4919-9cb8-c51cccbe31ae
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Farming Simulator 25
App.RootDir=./farming-simulator-25/
App.BaseDirectory=./farming-simulator-25/
App.StoresSupported=None
App.StoreSpecificSettings={}
App.StoreDownloadLocations={}
App.ExecutableWin=
App.ExecutableLinux=.proton/proton
App.WorkingDir=game
App.LinuxCommandLineArgs=runinprefix "{{$FullBaseDir}}game/dedicatedServer.exe"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} {{$FormattedArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"STEAM_COMPAT_DATA_PATH":"{{$FullRootDir}}.proton/compatdata","STEAM_COMPAT_CLIENT_INSTALL_PATH":"{{$FullBaseDir}}.steam/steam","HOME":"{{$FullBaseDir}}","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter=
App.ExitMethod=SIGTERM
App.ExitMethodWindows=None
App.ExitTimeout=60
App.ExitString=
App.ExitFile=
App.RestartDelaySeconds=0
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[farming-simulator-25ports.json]
App.AdminPortRef=WebInterfacePort
App.PrimaryApplicationPortRef=WebInterfacePort
App.UniversalSleepApplicationUDPPortRef=MainGamePort
App.UniversalSleepSteamQueryPortRef=SteamQueryPort
App.MaxUsers=16
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=TailLogFile
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.StripANSIControlCodes=True
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=30
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.RCONSelectIPMethod=Default
App.TelnetLoginFormat={0}
App.TelnetNewLineType=Default
App.TailLogFilePath={{$FullBaseDir}}logs/server.log
App.UpdateSources=@IncludeJson[farming-simulator-25updates.json]
App.PreStartStages=@IncludeJson[farming-simulator-25start.json]
App.CommandTriggers={}
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=^Z:{{$FullBaseDir}}game/.*FarmingSimulator2025Game\.exe.*$
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.UseSteamQueryForStatus=False
App.WakeupMode=Any
App.ApplicationReadyMode=Immediate
App.QuiesceCommand=
App.DequiesceCommand=
App.QuiesceSettleDelayMilliseconds=5000
Console.FilterMatchRegex=^\[\d{2}/\w{3}/\d{4}(?::\d{2}){3}\] (?<message>.*)$
Console.FilterMatchReplacement=${message}
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.PreConnectRegex=
Console.ConnectIPRegex=
Console.MetricsRegex=
Console.ServerInfoRegex=
Console.ServerAuthURLPromptRegex=
Console.ServerAuthAckRegex=
Console.ConsoleFormatRegex=
Console.DownloadProgressRegex=^Downloading: (?<ProgressPercent>[\d.]+)% \((?<DownloadProgress>[\d.]+) (?<DownloadProgressUnits>[KMG]B) of (?<DownloadTotal>[\d.]+) (?<DownloadTotalUnits>[KMG]B)\)$
Console.HideFromConsoleRegex=
Console.SuppressLogAtStart=False
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
