[
    {
        "DisplayName": "Minecraft Version",
        "Category": "MohistMC:stadia_controller",
        "Subcategory": "Server:dns:1",
        "Description": "Sets the Minecraft version of MohistMC to install. Each version runs Forge mods built for that Minecraft version. To run a different Minecraft version, create a new instance: libraries, mods and worlds from one version do not work with another",
