        "FieldName": "MohistVersion",
        "InputType": "enum",
        "ParamFieldName": "MohistVersion",
        "IncludeInCommandLine": false,
        "DefaultValue": "1.20.1",
        "EnumValues": {
            "1.20.2": "1.20.2",
            "1.20.1": "1.20.1 (default)",
            "1.19.4": "1.19.4",
            "1.19.2": "1.19.2",
            "1.18.2": "1.18.2",
            "1.16.5": "1.16.5",
            "1.12.2": "1.12.2",
            "1.7.10": "1.7.10"
        }
    },
