Meta.DisplayName=Star Conflict
Meta.Description=Star Conflict local server (Hub, cloud services and bundled MongoDB)
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=amp-template-bot
Meta.URL=https://star-conflict.com/
Meta.DisplayImageSource=steam:212070
Meta.EndpointURIFormat={ip}:{GenericModule.App.Ports.$LoadBalancerPort}
Meta.ConfigManifest=star-conflictconfig.json
Meta.MetaConfigManifest=star-conflictmetaconfig.json
Meta.ConfigRoot=star-conflict.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=The server is a Windows build that requires Wine (ideally latest stable from winehq.org) to run on Linux. Using a container avoids the need for you to install this dependency on the host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Initial release.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=9d3f6a2e-4b71-4c8e-a5d2-7e1b0c94f6a3
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Star Conflict
App.RootDir=./star-conflict/
App.BaseDirectory=./star-conflict/212070/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=$PATH\powershell.exe
App.ExecutableLinux=/bin/bash
App.WorkingDir=212070
App.LinuxCommandLineArgs="{{$FullRootDir}}star-conflictlaunch.sh" "{{$FullBaseDir}}" "{{$FullRootDir}}" {{$HubPort}} {{$HubStatusPort}} {{$MongoPort}} {{$LoadBalancerPort}} {{$ShardPort}} {{$ChatPort}} {{$BattlePort}} "{{PublicAddress}}" "{{$ExternalIP}}"
App.WindowsCommandLineArgs=-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{{$FullRootDir}}star-conflictlaunch.ps1" -ServerDir "{{$FullBaseDir}}." -DataDir "{{$FullRootDir}}." -HubPort {{$HubPort}} -HubStatusPort {{$HubStatusPort}} -MongoPort {{$MongoPort}} -LoadBalancerPort {{$LoadBalancerPort}} -ShardPort {{$ShardPort}} -ChatPort {{$ChatPort}} -BattlePort {{$BattlePort}} -PublicAddress "{{PublicAddress}}" -DetectedIP "{{$ExternalIP}}"
App.CommandLineArgs={{$PlatformArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all","WINEDLLOVERRIDES":"mscoree,mshtml="}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=120
App.ExitString=quit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[star-conflictports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=LoadBalancerPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=100
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[star-conflictupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(\d\d:\d\d:\d\d\.\d+\s+\|\s+(\*{5,}.*|\s?\w+(\[\s*\d+\])?\s+= .*|Hub::OnConnect, .*|NetEndpoint::Update: incoming connection .*|Hub::OnDisconnect, .*)|.*fixme:.*)$
Console.AppReadyRegex=^Star Conflict server is ready: .*$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=^$
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
